# Start in demo mode first. Demo mode uses a tiny illustrative in-memory fixture.
# To query your live cloud graph, change APP_MODE=cloud and fill the connection below.
APP_MODE=demo
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# The graph name in your FalkorDB Cloud workspace (as created in the Browser).
FALKORDB_GRAPH_NAME=bitcoin_investigator

# Option A: set FALKORDB_URL to the private connection URL from FalkorDB Cloud.
# Use rediss:// for TLS. The URL may contain credentials, so keep it only in .env.
FALKORDB_URL=

# Option B: provide connection fields separately. Host is the hostname only; port is numeric.
FALKORDB_HOST=
FALKORDB_PORT=51557
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Set this to match the connection security setting for your Cloud instance.
FALKORDB_SSL=true

# Safety/performance limits
FALKORDB_QUERY_TIMEOUT_MS=4000
FALKORDB_SOCKET_TIMEOUT_SECONDS=8
MAX_TRACE_PATHS=20
MAX_CASE_LIST=50

# Analyst model provider: "local" (default) or "cloud".
# Tool calls are restricted to read-only graph methods for both providers.
MODEL_PROVIDER=local
OLLAMA_TIMEOUT_SECONDS=90

# Local Ollama agent.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama Cloud agent (used only when MODEL_PROVIDER=cloud).
# The API key is a secret: keep it in .env only; never commit, log, or expose it to the browser.
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# Localhost development defaults to no login. Every non-local APP_HOST requires
# Cognito configuration; use a public app client with Authorization Code + PKCE.
AUTH_MODE=none
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_CALLBACK_URL=http://localhost:8000/
COGNITO_SCOPES=openid email phone
